{
  "name": "my-line-bot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bottender dev",
    "dev:next": "next dev",
    "build": "prisma generate && (prisma db push --skip-generate --accept-data-loss || true) && next build",
    "start": "bottender start",
    "start:next": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "create-rich-menu": "tsx scripts/createRichMenu.ts",
    "test-features": "tsx scripts/test-features.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@line/bot-sdk": "^10.5.0",
    "@prisma/client": "^6.19.0",
    "bottender": "^1.5.5",
    "next": "16.0.3",
    "openai": "^6.9.1",
    "prisma": "^6.19.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
