// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  userId           String?  @default(cuid())
  email            String   @unique
  phone            String?  @unique
  password         String
  name             String
  birthday         DateTime
  gender           String // "male", "female", "other"
  location         String?
  height           Int? // in cm
  weight           Int? // in kg
  occupation       String? // 職業
  school           String? // 學校
  bloodType        String? // 血型 (A, B, AB, O)
  bio              String?
  energy           Int      @default(100) // 体力值
  energyMax        Int      @default(100)
  lastEnergyRefill DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  isVerified       Boolean  @default(false)
  isActive         Boolean  @default(true)

  // Relations
  photos                 Photo[]
  tags                   UserTag[]
  matches                Match[]          @relation("UserMatches")
  matchesAsMatched       Match[]          @relation("MatchedUser")
  ratings                Rating[]
  receivedRatings        Rating[]         @relation("RatedUser")
  messages               Message[]
  qaAnswers              QAAnswer[]
  unlockProgress         UnlockProgress[]
  unlockProgressAsTarget UnlockProgress[] @relation("TargetUser")
  matchPreference        MatchPreference?
  posts                  Post[]
  postLikes              PostLike[]
  favorites              Favorite[]
  topics                 Topic[]          @relation("UserTopics")

  @@index([email])
  @@index([userId])
  @@index([location])
}

model DailyTopic {
  id        String   @id @default(cuid())
  date      DateTime
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts Post[] @relation("DailyTopicPosts")

  @@unique([date])
  @@index([date])
}

// 使用者自訂主題（board）
model Topic {
  id             String   @id @default(cuid())
  title          String
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastActivityAt DateTime @default(now())

  creator User   @relation("UserTopics", fields: [createdBy], references: [id], onDelete: Cascade)
  posts   Post[] @relation("BoardPosts")

  @@index([createdBy])
  @@index([title])
  @@index([lastActivityAt])
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  content   String
  imageUrl  String?
  type      String   @default("FREE") // "FREE" | "TOPIC"
  topicId   String? // DailyTopic
  boardId   String? // Topic (board)
  likeCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  topic     DailyTopic? @relation("DailyTopicPosts", fields: [topicId], references: [id], onDelete: SetNull)
  board     Topic?      @relation("BoardPosts", fields: [boardId], references: [id], onDelete: SetNull)
  likes     PostLike[]
  favorites Favorite[]

  @@index([authorId])
  @@index([topicId])
  @@index([boardId])
  @@index([createdAt])
  @@index([likeCount])
}

model PostLike {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model Photo {
  id        String   @id @default(cuid())
  userId    String
  url       String
  blurLevel Int      @default(100) // 0-100, 100 = fully blurred
  isCover   Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String // "interest", "personality", "lifestyle", "appearance"
  createdAt DateTime @default(now())

  users UserTag[]
}

model UserTag {
  id     String @id @default(cuid())
  userId String
  tagId  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([userId, tagId])
  @@index([userId])
}

model Match {
  id            String    @id @default(cuid())
  userId        String
  matchedUserId String
  status        String    @default("pending") // "pending", "matched", "rejected"
  totalScore    Int       @default(0) // 双方评分总和
  matchedAt     DateTime?
  createdAt     DateTime  @default(now())

  user         User          @relation("UserMatches", fields: [userId], references: [id], onDelete: Cascade)
  matchedUser  User          @relation("MatchedUser", fields: [matchedUserId], references: [id], onDelete: Cascade)
  messages     Message[]
  gameSessions GameSession[]

  @@unique([userId, matchedUserId])
  @@index([userId])
  @@index([matchedUserId])
}

model Rating {
  id          String   @id @default(cuid())
  userId      String // 评分者
  ratedUserId String // 被评分者
  score       Int // 1-5
  createdAt   DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratedUser User @relation("RatedUser", fields: [ratedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, ratedUserId])
  @@index([userId])
  @@index([ratedUserId])
}

model Message {
  id        String   @id @default(cuid())
  matchId   String
  senderId  String
  content   String
  type      String   @default("text") // "text", "image", "sticker", "voice"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([senderId])
}

model Question {
  id        String   @id @default(cuid())
  content   String
  category  String // "interest", "personality", "lifestyle", "icebreaker"
  type      String   @default("multiple_choice") // "multiple_choice", "yes_no", "open"
  options   String? // JSON array for multiple choice
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)

  answers QAAnswer[]
}

model QAAnswer {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  answer     String // JSON or text
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
}

model UnlockProgress {
  id               String   @id @default(cuid())
  userId           String // 解锁者
  targetUserId     String // 被解锁照片的用户
  unlockLevel      Int      @default(0) // 0-100, 解锁进度
  qaCompleted      Int      @default(0) // 完成的问答数量
  interactionCount Int      @default(0) // 互动次数
  keys             Int      @default(0) // 钥匙数量
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetUser User @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([userId, targetUserId])
  @@index([userId])
  @@index([targetUserId])
}

model GameSession {
  id              String   @id @default(cuid())
  matchId         String
  initiatorId     String // 发起者
  responderId     String // 回答者
  topic           String? // 主题
  questionId      String? // 当前问题ID
  responderAnswer String? // 回答者的答案
  initiatorGuess  String? // 发起者的猜测
  status          String   @default("pending") // "pending", "waiting_answer", "waiting_guess", "completed"
  winnerId        String? // 获胜者（得到钥匙的人）
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([initiatorId])
  @@index([responderId])
}

model MatchPreference {
  id          String   @id @default(cuid())
  userId      String   @unique
  gender      String?  // "male", "female", "other", null = 不限
  minAge      Int?     // 最小年龄
  maxAge      Int?     // 最大年龄
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
