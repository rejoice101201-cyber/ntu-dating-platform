# 咖啡廳探索應用 - 前端環境變數配置
# ⚠️  重要：複製此檔案為 .env 並填入實際值後再啟動應用
# ⚠️  未設定正確的 API 金鑰將導致地圖功能無法運作

# Google Maps JavaScript API Key (用於地圖顯示)
# 🔑 取得方式：
# 1. 前往 Google Cloud Console (https://console.cloud.google.com/google/maps-apis)
# 2. 啟用 Maps JavaScript API
# 3. 建立 API 金鑰
# 4. 限制金鑰使用範圍 (建議限制 HTTP referrer: http://localhost:5173/*)
# 5. 將下方 YOUR_BROWSER_KEY 替換為你的實際金鑰
VITE_GOOGLE_MAPS_JS_KEY=YOUR_BROWSER_KEY

# API 基礎 URL (通常不需要修改)
VITE_API_BASE_URL=http://localhost:3000

# 開發環境設定
VITE_NODE_ENV=development
