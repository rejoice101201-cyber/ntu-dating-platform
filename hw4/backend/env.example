# 咖啡廳探索應用 - 後端環境變數配置
# ⚠️  重要：複製此檔案為 .env 並填入實際值後再啟動應用
# ⚠️  未設定正確的 API 金鑰將導致搜尋功能無法運作

# 服務器端口
PORT=3000

# JWT 密鑰 (請使用強密碼)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Google Maps Server API Key (用於 Places API)
# 🔑 取得方式：
# 1. 前往 Google Cloud Console (https://console.cloud.google.com/google/maps-apis)
# 2. 啟用以下 API：
#    - Places API (地點搜尋)
#    - Geocoding API (地址轉換)
#    - Directions API (路線規劃)
# 3. 建立 API 金鑰
# 4. 限制金鑰使用範圍 (建議限制 IP: localhost)
# 5. 將下方 YOUR_SERVER_KEY 替換為你的實際金鑰
GOOGLE_SERVER_KEY=YOUR_SERVER_KEY

# 資料庫路徑
DATABASE_PATH=./db.sqlite

# 開發環境設定
NODE_ENV=development
